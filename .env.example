# Lead delivery. Copy this file to .env.local and fill it in. Never commit real keys.
# See "Lead delivery" in README.md for where each value comes from.

# Email (Resend)
RESEND_API_KEY=
LEAD_TO_EMAIL=devisynstudio@gmail.com
# Sender. Works with no domain but only delivers to your own Resend account email.
# Once you own a domain, verify it in Resend and change just this line, e.g. Devisyn Leads <leads@yourdomain.com>
LEAD_FROM_EMAIL=Devisyn Leads <onboarding@resend.dev>

# Google Sheet (Apps Script web app, see docs/google-sheet-lead-script.gs)
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=
# Link to the sheet itself, shown as a button in the lead email (optional)
SHEET_URL=

# Public URL used for canonical links, sitemap, Open Graph and structured data.
# Switching domains later is this one line, for example https://devisyn.com
NEXT_PUBLIC_SITE_URL=https://devisyn.vercel.app

# Optional booking link (for example a Cal.com link). The "Book a 15-minute call" button shows only when set.
NEXT_PUBLIC_BOOKING_URL=
